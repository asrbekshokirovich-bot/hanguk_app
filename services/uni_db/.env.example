# services/uni_db — environment variables
#
# Phase 0 status: ALL paid integrations are stubbed. The Python code reads these
# envvars but call sites are gated behind UNI_DB_LIVE_APIS=false (the default).
# To enable a particular live integration in a later phase, flip the flag and
# fill the corresponding key.
#
# Copy this file to `.env` (root of services/uni_db/) and fill values you want
# locally. .env is gitignored.

# -----------------------------------------------------------------------------
# Master kill-switch — keeps every paid call disabled even if keys are present.
# -----------------------------------------------------------------------------
# Set to "true" only after owner approval.
# IMPORTANT: pydantic-settings does not strip inline `# comments` after a value.
# Keep all explanatory text on its own line (prefixed with `#`) above the KEY=value.
UNI_DB_LIVE_APIS=false
# If false, crawlers run against tests/fixtures/ instead of touching live ac.kr boards.
UNI_DB_LIVE_CRAWL=false
# development | staging | production
UNI_DB_ENV=development

# -----------------------------------------------------------------------------
# Postgres / Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Used by Python workers only — never ship to client.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3-compatible)
# Phase 0: bucket NOT yet provisioned. Leave blank.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_GUIDELINE_BLOBS=guideline-blobs
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Anthropic — extraction + translation prose
# Phase 0: key absent; mock_llm_response() returns canned outputs.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-4-6
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5
ANTHROPIC_MODEL_TRANSLATE=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Naver Clova OCR — Korean PDF OCR
# Phase 0: stubbed. Plan §J budgets ~$80/mo at scale.
# -----------------------------------------------------------------------------
NAVER_CLOVA_OCR_INVOKE_URL=
NAVER_CLOVA_OCR_SECRET_KEY=

# -----------------------------------------------------------------------------
# Naver Search API — primary discovery (KR-native)
# -----------------------------------------------------------------------------
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Naver Papago — translation (ko<->vi/id)
# -----------------------------------------------------------------------------
NAVER_PAPAGO_CLIENT_ID=
NAVER_PAPAGO_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# DeepL — translation (ko<->en/ru)
# -----------------------------------------------------------------------------
DEEPL_API_KEY=

# -----------------------------------------------------------------------------
# Google Programmable Search Engine — fallback discovery
# -----------------------------------------------------------------------------
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=

# -----------------------------------------------------------------------------
# data.go.kr — public OpenAPI app key (free dev tier; required by audit §3.3)
# -----------------------------------------------------------------------------
DATA_GO_KR_APP_KEY=

# -----------------------------------------------------------------------------
# MOE Adiga (어디가) — KCUE unified portal
# -----------------------------------------------------------------------------
ADIGA_APP_KEY=

# -----------------------------------------------------------------------------
# Push notifications — wired in Phase 3 (§I)
# -----------------------------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=

# -----------------------------------------------------------------------------
# Worker placement — Phase 0 stays local; later moves to Hetzner VPS
# -----------------------------------------------------------------------------
WORKER_HOST=local
HTTP_USER_AGENT=HangukUniDBBot/0.1 (+contact: ops@hanguk.example)
HTTP_REQUEST_TIMEOUT_SEC=30
HTTP_PER_DOMAIN_RPS=1.0
HTTP_JITTER_MIN_SEC=2
HTTP_JITTER_MAX_SEC=15

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
