<?xml version="1.0" encoding="utf-8"?>
<!--
  P1 #18: Auto-backup exclusion rules (Android 6.0 – 11).

  We allow auto-backup at the application level (android:allowBackup is not
  explicitly disabled) so the user keeps app placement / icon position on
  reinstall, but we exclude every store of sensitive data:

  * sharedpref domain — Hanguk doesn't currently use SharedPreferences for
    secrets (flutter_secure_storage covers that path), but the rule is
    defensive in case a future feature regresses.
  * database domain — local SQLite caches may contain PII.
  * flutter_secure_storage — the EncryptedSharedPreferences-backed token
    store. Including this would defeat the purpose of secure storage.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="flutter_secure_storage"/>
</full-backup-content>
