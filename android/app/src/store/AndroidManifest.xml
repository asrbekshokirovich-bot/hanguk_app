<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The install_plugin dependency declares REQUEST_INSTALL_PACKAGES in its
         own library manifest, which the manifest merger would otherwise pull
         into every flavor. Google Play prohibits sideloading APK installs, so
         strip the permission from the "store" flavor. Store builds update
         through Play in-app updates (in_app_update), not the APK installer. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- A transitive plugin re-injects the broad media-read permissions into
         the merged manifest. Document/photo uploads use file_picker, which
         relies on the Storage Access Framework (system document picker) and
         returns only the user-selected file, so the app needs neither of
         these. Strip them from the store bundle so Google Play does not
         require the Photo and video permissions declaration. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
</manifest>
