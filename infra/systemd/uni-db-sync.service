[Unit]
Description=uni_db full sync cycle: discovery -> fetch+parse -> translate (one-shot, timer-triggered)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=uni-db
Group=uni-db
WorkingDirectory=/opt/uni_db/services/uni_db
EnvironmentFile=/etc/uni_db/env
# Three stages, run in order. The leading '-' makes each best-effort: a
# single bad PDF or a transient network blip is logged but does not block the
# rest of the cycle. The source registry's seasonal cadence (due_sources)
# decides which sources actually poll on each run, so hourly firing is cheap
# and self-throttling.
#   1. discovery  — poll due sources, write announcements (+ classifier label)
#   2. run-pipeline — fetch guideline PDFs -> documents -> extract -> review_queue
#   3. translate  — fill EN/UZ translations for the review screen
ExecStart=-/opt/uni_db/services/uni_db/.venv/bin/python scripts/run_discovery_once.py --since 2
ExecStart=-/opt/uni_db/services/uni_db/.venv/bin/uni-db run-pipeline --limit 50
ExecStart=-/opt/uni_db/services/uni_db/.venv/bin/python scripts/run_translate_once.py --limit 100
# A full cycle (12 universities, ~5 field groups each) stays well under an hour.
TimeoutStartSec=3600

# Hardening (mirrors the other units)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/cache/uni_db /var/log/uni_db
StandardOutput=journal
StandardError=journal

# Resource caps — PDF parse + extraction is the heavy step.
MemoryMax=2G
CPUQuota=180%

[Install]
WantedBy=multi-user.target
