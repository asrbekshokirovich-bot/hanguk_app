[Unit]
Description=Run uni_db discovery poll every 6 hours
Requires=uni-db-discovery-poll.service

[Timer]
# 00:00, 06:00, 12:00, 18:00 local
OnCalendar=00,06,12,18:00
# Catch up if the VPS was off
Persistent=true
# Spread load if multiple discovery boxes ever exist
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
