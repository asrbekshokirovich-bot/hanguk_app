[Unit]
Description=uni_db extract worker (long-running queue poller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uni-db
Group=uni-db
WorkingDirectory=/opt/uni_db/services/uni_db
EnvironmentFile=/etc/uni_db/env
ExecStart=/opt/uni_db/services/uni_db/.venv/bin/python -m uni_db.workers.parse_worker
Restart=on-failure
RestartSec=10

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/cache/uni_db /var/log/uni_db
StandardOutput=journal
StandardError=journal

# Resource caps — prevent a runaway worker from starving the box
MemoryMax=2G
CPUQuota=180%

[Install]
WantedBy=multi-user.target
