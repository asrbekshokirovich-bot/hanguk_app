[Unit]
Description=Run the uni_db full sync cycle hourly
Requires=uni-db-sync.service

[Timer]
# Hourly. Off-season (Jun-Aug) the per-source cadence widens automatically
# (registry.next_interval_minutes), so most hourly fires poll nothing and
# cost nothing; in-season, new/changed guidelines surface within ~1 hour.
OnCalendar=hourly
# Run a missed cycle if the box was off at fire time.
Persistent=true
# Avoid hitting ac.kr exactly on the hour.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
