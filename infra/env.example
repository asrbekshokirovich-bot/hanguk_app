# /etc/uni_db/env — copy to /etc/uni_db/env on the VPS and fill in.
# Mode 640, owned root:uni-db.
#
# Source-of-truth field set is services/uni_db/.env.example (which the
# Python config.py reads). This file is the systemd-friendly subset
# without comments — keep the two in sync when you add new envvars.

# --- master flags ---
UNI_DB_LIVE_APIS=true
UNI_DB_LIVE_CRAWL=false
UNI_DB_ENV=production
UNI_DB_OCR_PROVIDER=easyocr
UNI_DB_BLOB_STORAGE=supabase_storage
UNI_DB_TRANSLATION_LANGUAGES=en,uz

# --- Supabase ---
SUPABASE_URL=https://lysjdtyanhdfphqyijsr.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-4-6
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5
ANTHROPIC_MODEL_TRANSLATE=claude-sonnet-4-6

# --- Naver ---
NAVER_PAPAGO_CLIENT_ID=
NAVER_PAPAGO_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# --- DeepL ---
DEEPL_API_KEY=

# --- Korean public APIs ---
DATA_GO_KR_APP_KEY=
ADIGA_APP_KEY=

# --- HTTP ---
HTTP_USER_AGENT=HangukUniDBBot/0.1 (+contact: ops@hanguk.example)
HTTP_REQUEST_TIMEOUT_SEC=30
HTTP_PER_DOMAIN_RPS=1.0
HTTP_JITTER_MIN_SEC=2
HTTP_JITTER_MAX_SEC=15

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
